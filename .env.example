# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Vercel Server-Side Variables ──────────────────────────────────────────────
# These are set in Vercel Project Settings → Environment Variables.
# They are NEVER passed to the Flutter build or compiled into client JavaScript.

# Google Gemini API Key (server-side only, used by api/recommend.js)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Flutter Build Variables (public, not secret) ──────────────────────────────
# Set this only if you build Flutter Android/iOS apps that need to call the
# backend. This is a public URL — not a secret.
# AI_BACKEND_URL=https://your-project.vercel.app
